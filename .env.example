# ---------- База данных ----------
DB_HOST=db
DB_PORT=5432
DB_USER=ecommerce_user
DB_PASSWORD=change-me
DB_NAME=ecommerce_db

# ---------- JWT ----------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Отдельный ключ для сессии админки (должен отличаться от SECRET_KEY)
SESSION_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- Приложение ----------
# true только для локальной разработки; при false приложение не стартует с дефолтными секретами
DEBUG=true
# JSON-список разрешённых origin
ALLOWED_ORIGINS=["http://localhost:5173"]

# ---------- Админка ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- S3 (Yandex Object Storage) ----------
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=https://storage.yandexcloud.net

# ---------- ЮKassa ----------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8000/docs
